{
  "manifest_version": 3,
  "name": "신삼국지 같이보기 예고편 스포일러 방지",
  "version": "1.4.0",
  "description": "치지직에서 영상의 마지막 30초(다음 화 예고편) 화면을 자동으로 가립니다.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
